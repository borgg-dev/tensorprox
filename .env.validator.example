# =============================================================================
# TensorProx Validator Configuration
# =============================================================================
# Copy to .env.validator and fill in your values.
# See assets/validator.md for detailed documentation.
#
# Legend:
#   - Uncommented variables = REQUIRED (must be set)
#   - Commented variables = OPTIONAL (have defaults or provided later)
# =============================================================================

# =============================================================================
# BITTENSOR IDENTITY (Required)
# =============================================================================

TP_WALLET_NAME=your-wallet
TP_WALLET_HOTKEY=your-validator-hotkey
TP_WALLET_PATH=~/.bittensor/wallets
TP_SUBTENSOR_NETWORK=finney
TP_NETUID=91

# =============================================================================
# NETWORK PORTS (Required)
# =============================================================================

TP_AXON_PORT=8191
TP_TPM_PORT=5001

# =============================================================================
# POSTGRESQL DATABASE (Required)
# =============================================================================

TP_DB_NAME=tp_state
TP_DB_HOST=localhost
TP_DB_PORT=5432
TP_DB_USER=tp_api
TP_DB_PASS=your_secure_db_password

# =============================================================================
# REDIS (Required)
# =============================================================================

# Redis URL with password
TP_REDIS_URL=redis://:your_redis_password@127.0.0.1:6379
TP_REDIS_PASSWORD=your_redis_password

# External Redis access for exit hubs (use your PUBLIC IP)
TP_REDIS_EXTERNAL_HOST=your.public.ip.address
TP_REDIS_EXTERNAL_PORT=6379

# =============================================================================
# TPM CONFIGURATION (Required)
# =============================================================================

# Public URL where miners can reach your TPM (use your PUBLIC IP)
TPM_PUBLIC_URL=http://your.public.ip.address:5001

# Internal secret for TPM authentication
# Generate with: openssl rand -hex 32
TPM_INTERNAL_SECRET=generate_a_secure_random_string_here

# =============================================================================
# AWS CREDENTIALS (Required - for exit hub deployment)
# =============================================================================

TP_AWS_ACCESS_KEY_ID=your-aws-access-key
TP_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
TP_AWS_REGION=us-east-1
TP_AWS_SSH_KEY_NAME=your-ssh-key-name

# =============================================================================
# SSH KEY (Required)
# =============================================================================

TP_SSH_KEY_PATH=~/.ssh/your-key.pem

# =============================================================================
# MAXMIND GEOIP (Recommended)
# For distance-based latency normalization in audit scoring.
# Get free license at: https://www.maxmind.com/en/geolite2/signup
# =============================================================================

# TPM_MAXMIND_LICENSE_KEY=your_maxmind_license_key
# TPM_GEOLITE2_DB_PATH=~/.tensorprox/GeoLite2-City.mmdb

# =============================================================================
# WEIGHTS & BIASES
# Public audit dashboard for miners to view scores.
# Dashboard: https://wandb.ai/shugo-labs/tensorprox
# =============================================================================

# Enable W&B logging (set to true and provide API key to enable)
# TP_WANDB_ENABLED=true
TP_WANDB_PROJECT=tensorprox
TP_WANDB_ENTITY=shugo-labs
# Get your API key at: https://wandb.ai/authorize
# TP_WANDB_API_KEY=your-wandb-api-key

# =============================================================================
# TP DATA - TIME SERIES ORIGIN METRICS
# Validators report metrics to the TensorProx dashboard.
# Shugo Labs will provide these credentials during onboarding.
# Contact: Discord (https://discord.gg/shugo-labs) or support@shugo.io
# =============================================================================

# TP_DATA_DB_HOST=lin-xxxxx-xxxxx-pgsql-primary.servers.linodedb.net
# TP_DATA_DB_PORT=5432
# TP_DATA_DB_NAME=tp_data
# TP_DATA_DB_USER=tp_validator
# TP_DATA_DB_PASSWORD=provided_by_shugo_labs
# TP_DATA_DB_SSLMODE=require
# TP_DATA_DB_SSLROOTCERT=/path/to/linode-ca-certificate.crt


# =============================================================================
# AWS ADVANCED (Optional - auto-created if not specified)
# =============================================================================

# TP_AWS_VPC_ID=vpc-xxx
# TP_AWS_SUBNET_ID=subnet-xxx
# TP_AWS_SECURITY_GROUP_ID=sg-xxx

# =============================================================================
# WEB APP BACKEND (Required - validators report to the web app independently)
# =============================================================================

# Single URL for all webapp communication (origin sync, metrics, heartbeats)
TP_WEBAPP_URL=https://api.tensorprox.io
# API key for webapp authentication. Contact Shugo Labs for onboarding:
# Discord: https://discord.gg/shugo-labs | Email: support@shugo.io
TP_WEBAPP_API_KEY=your_webapp_api_key

# =============================================================================
# LINODE (Optional - if using Linode for exit hubs instead of AWS)
# =============================================================================

# LINODE_TOKEN=your-linode-personal-access-token
