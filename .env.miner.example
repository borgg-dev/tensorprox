# =============================================================================
# TensorProx Miner Configuration
# =============================================================================
# Copy to .env.miner and fill in your values.
# See assets/miner.md for detailed documentation.
#
# Legend:
#   - Uncommented variables = REQUIRED (must be set)
#   - Commented variables = OPTIONAL (have defaults)
# =============================================================================

# =============================================================================
# BITTENSOR IDENTITY (Required)
# =============================================================================

# Bittensor wallet name (created with btcli wallet new_coldkey)
TP_WALLET_NAME=your-wallet
# Hotkey name for this miner (created with btcli wallet new_hotkey)
TP_WALLET_HOTKEY=your-miner-hotkey
# Path to wallet directory
TP_WALLET_PATH=~/.bittensor/wallets
# Network: "finney" for mainnet, "test" for testnet
TP_SUBTENSOR_NETWORK=finney
# Subnet ID (91 = TensorProx mainnet)
TP_NETUID=91

# =============================================================================
# NETWORK PORTS (Required)
# =============================================================================

# Bittensor axon port (must be unique per miner on same machine)
TP_AXON_PORT=8091
# Miner control plane API port (internal management)
TP_MINER_PORT=8000

# =============================================================================
# POSTGRESQL DATABASE (Required)
# =============================================================================

# Database name for miner state
TP_DB_NAME=ecp_state
TP_DB_HOST=localhost
TP_DB_PORT=5432
# Database user (created by database/db_setup.sh)
TP_DB_USER=ecp_api
# Database password (must match what you set when running db_setup.sh)
TP_DB_PASS=your_secure_db_password

# =============================================================================
# REDIS (Required)
# =============================================================================

# Redis connection URL (password must match your Redis requirepass config)
TP_REDIS_URL=redis://:your_redis_password@127.0.0.1:6379

# =============================================================================
# SCRUBBER CONFIGURATION (Required)
# =============================================================================

# Cloud provider for scrubber deployment.
# Currently only "aws" is supported. Scrubbers rely on AWS-specific features
# (ENI/EIP networking, ens5 interface, EC2 metadata service, security groups).
# Multi-provider support (Linode, GCP, etc.) is planned for future releases.
TP_SCRUBBER_PROVIDER=aws

# AWS region for scrubber deployment
# Examples: us-east-1, us-west-2, eu-central-1, ap-northeast-1
TP_SCRUBBER_REGION=us-east-1

# AWS instance type
# Minimum: t3.medium | Recommended: t3.large | Production: c5.large
TP_SCRUBBER_INSTANCE_TYPE=t3.medium

# =============================================================================
# SSH KEY (Required)
# =============================================================================

# Path to SSH private key for accessing scrubber instances
TP_SSH_KEY_PATH=~/.ssh/your-key.pem

# =============================================================================
# AWS CREDENTIALS (Required)
# =============================================================================

# AWS IAM credentials (needs EC2 full access for scrubber management)
TP_AWS_ACCESS_KEY_ID=your-aws-access-key
TP_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS region for scrubber deployment (should match TP_SCRUBBER_REGION)
TP_AWS_REGION=us-east-1
# Name of your SSH key pair in AWS EC2
TP_AWS_SSH_KEY_NAME=your-ssh-key-name

# =============================================================================
# AWS ADVANCED (Optional - auto-created if not specified)
# =============================================================================

# Use specific VPC/subnet/security group
# TP_AWS_VPC_ID=vpc-xxx
# TP_AWS_SUBNET_ID=subnet-xxx
# TP_AWS_SECURITY_GROUP_ID=sg-xxx

# EIP quota per region (default: 5, request increase from AWS if needed)
# TP_AWS_EIP_QUOTA_PER_REGION=5

